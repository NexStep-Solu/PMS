# ---------------------------------------------------------------------------
# PMS environment
#
# Copy to `.env.local` for local development.
#
# Leave BOTH values empty (or delete the file) to run the app against the
# in-memory demo backend — no account or network required.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY in here. This file is bundled into the
# browser; only the anon/publishable key may be exposed.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / publishable key (Project Settings → API)
VITE_SUPABASE_ANON_KEY=
